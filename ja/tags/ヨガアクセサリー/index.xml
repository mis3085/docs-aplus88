        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e3%83%a6%e3%83%8b%e3%83%bc%e3%82%af%e3%81%aa%e3%83%a8%e3%82%ac%e3%81%a8%e3%83%95%e3%82%a3%e3%83%83%e3%83%88%e3%83%8d%e3%82%b9%e3%82%a2%e3%82%af%e3%82%bb%e3%82%b5%e3%83%aa%e3%83%bc%e3%82%92%e7%99%ba%e8%a6%8b&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
